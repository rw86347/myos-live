# Process 1 when the live USB's ext2 root is not visible (this kernel
# has no USB mass storage yet). Same path as a disk boot: runit starts
# myos-login, which starts X and draws the Golden Hour login.
export HOME=/
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export TERM=linux
exec /sbin/init
