# /etc/runit/1 — runit's stage 1: bring the machine up, once.
#
# Process 1 is runit (/sbin/init -> runit-init). It runs three stages, the
# same layout as Void Linux:
#   1  this file: kernel file systems, the first-boot install, hostname
#   2  /etc/runit/2: supervise the services in /var/service until shutdown
#   3  /etc/runit/3: stop the services, write everything to disk
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# The kernel file systems Linux programs expect. MyOS's kernel puts /dev on
# the root itself and has no /proc, /sys or tmpfs yet: a mount that fails is
# skipped (then /run is a plain folder), not fatal.
mkdir -p /proc /sys /run                # a mount needs its mount point to exist
mountpoint -q /proc || mount -t proc -o nosuid,noexec,nodev proc /proc 2>/dev/null
mountpoint -q /sys  || mount -t sysfs -o nosuid,noexec,nodev sys /sys 2>/dev/null
mountpoint -q /run  || mount -t tmpfs -o mode=0755,nosuid,nodev run /run 2>/dev/null
# POSIX shared memory (shm_open): Firefox, GTK and Mesa look here.
# System V shm (shmget) is a different thing, in the kernel.
mkdir -p /dev/shm
mountpoint -q /dev/shm || mount -t tmpfs -o mode=1777,nosuid,nodev,noexec shm /dev/shm 2>/dev/null
mkdir -p /run/runit /tmp /var/log
chmod 1777 /tmp
# The kernel's messages from this start, kept on disk: the kernel's own copy
# is gone at the next start, and a machine with no serial port or network
# (a new laptop, a VM) has no other way to show what the kernel found. The
# start before is kept as boot.log.old. Root only: they hold kernel addresses.
[ -f /var/log/boot.log ] && mv -f /var/log/boot.log /var/log/boot.log.old
(umask 077; dmesg > /var/log/boot.log 2>/dev/null)
# The mount table, as on any Linux: mount, df and GLib read /etc/mtab.
[ -L /etc/mtab ] || ln -sf /proc/self/mounts /etc/mtab

# The nameserver, from whoever answered DHCP. The kernel is the DHCP client,
# so it reports this network's resolver as /proc/net/dns, in resolv.conf's
# format, made when it is read. /etc/resolv.conf is a link to it, not a copy:
# on a laptop Wi-Fi's lease arrives seconds after this script (and again after
# every reconnect), and a copy made now would say "no nameserver" for good.
# musl reads resolv.conf afresh for every lookup. Skipped quietly if /proc
# didn't mount or the root is read-only.
[ -r /proc/net/dns ] && ln -sfn /proc/net/dns /etc/resolv.conf 2>/dev/null

# runit's controls: `reboot` and `poweroff` (runit-init 6 / 0) make these
# executable and wake process 1. They live in /run (via the links in
# /etc/runit) so the root file system may be read-only.
install -m 000 /dev/null /run/runit/stopit
install -m 000 /dev/null /run/runit/reboot
# Each service's runsv keeps its state in supervise/, a link into /run
# for the same reason; runsv doesn't create the folder behind the link.
for l in /etc/sv/*/supervise; do
    [ -L "$l" ] && mkdir -p "$(readlink "$l")"
done

[ -e /etc/myos/first-boot.done ] || /etc/myos/first-boot.sh

# Building the image (tools/live-prepare.py boots it once, so that the first
# boot's 10-15 s of caches and databases happen on the build machine, not on
# every stick): keep nothing that has to differ between machines, and shut
# down. Exit code 100 makes runit skip stage 2 and run stage 3, which writes
# everything out and powers off.
if [ -e /etc/myos/first-boot.build ]; then
    rm -f /etc/machine-id /etc/ssh/ssh_host_* /var/log/boot.log /var/log/boot.log.old
    rm -f /etc/myos/first-boot.build
    echo "MyOS: the first boot's work is done; this image is ready to ship."
    exit 100
fi
# This machine's own D-Bus id (/etc/machine-id), once: every image ships
# without one, so no two machines share it.
[ -s /etc/machine-id ] || dbus-uuidgen --ensure=/etc/machine-id 2>/dev/null

hostname -F /etc/hostname 2>/dev/null
echo "MyOS is up."
