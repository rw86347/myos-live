# Run by icewm-session once IceWM is up: the parts of the desktop that are ours.
# myos-menu is the Start menu (see live/myos-menu/myos-menu.c).
myos-menu &
# Mission Control's miniatures show the other desktops' windows as they were
# when you left them; this keeps those pictures (see keep() in
# live/myos-mission/myos-mission.c), and slides to another desktop when a
# taskbar button or a three-finger swipe goes there.
myos-mission --keep &
# myos-wifi is the Wi-Fi icon in the tray (see live/myos-wifi/myos-wifi.c).
myos-wifi &
# Network Check was on the desktop while Wi-Fi was being debugged; the stick
# keeps homes across rewrites, so take down the link one kept from then.
[ -L "$HOME/Desktop/Network Check.command" ] && rm -f "$HOME/Desktop/Network Check.command"
# myos-desktop draws ~/Desktop on the wallpaper, and the right-click menu
# (see live/myos-desktop/myos-desktop.c).
myos-desktop &
# The Recycle can on the desktop (see live/myos-trash/myos-trash.c).
myos-trash &
# Ctrl+Space between English and pinyin, with its bubble (see
# live/myos-input/myos-input.c). Only where IBus is.
command -v myos-input > /dev/null && myos-input &
