# A login prompt on the console: the screen and keyboard. (MyOS's kernel has
# one terminal, /dev/console, so far; agetty-tty1 and agetty-ttyS0 are ready
# for when it has virtual terminals and a serial device node.)
exec agetty --noclear -L console linux
