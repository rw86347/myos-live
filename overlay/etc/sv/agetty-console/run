# A text login on the console. /sbin/init points /dev/console at the serial
# port, so this is the serial port's login; with no desktop (nodesktop) the
# login is on tty1, the screen. (Keys reach both: the kernel has one
# terminal behind the console, tty0-7 and ttyS0.)
if grep -qw nodesktop /proc/cmdline 2>/dev/null; then
    exec agetty --noclear tty1 linux
fi
exec agetty --noclear -L console linux
