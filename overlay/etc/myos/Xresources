! X resources for every user, loaded by /etc/myos/xsession before the user's
! own ~/.Xresources. Sizes are in points: myos-xsettings sets Xft.dpi from
! the desktop's scale (Settings > Displays), so points grow with it.

! xterm: an outline font instead of the default 6x13 bitmap, which no DPI
! can make bigger.
XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 11

! A scrollbar on the right and 10000 lines to scroll back through (dmesg
! is longer than a screen). Shift+PageUp / Shift+PageDown scroll too; the
! touchpad has no two-finger scrolling yet (it speaks plain PS/2 to us).
XTerm*scrollBar: true
XTerm*rightScrollBar: true
XTerm*saveLines: 10000
XTerm*scrollTtyOutput: false
XTerm*scrollKey: true
