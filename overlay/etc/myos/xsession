# xsession — what runs after a graphical login, as the user who logged in.
# Their own ~/.xsession if they have one, else the IceWM desktop (the same
# thing `startx` runs, /etc/X11/xinit/xinitrc). When this exits, the login
# screen comes back.

# Errors go to ~/.xsession-errors, as on every Linux desktop.
errfile="$HOME/.xsession-errors"
if ( umask 077 && : > "$errfile" ) 2>/dev/null; then
    exec > "$errfile" 2>&1
fi

xrdb -nocpp -load /etc/myos/Xresources
[ -r "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

# Firefox's content process sandbox needs seccomp and user namespaces,
# which this kernel does not have; without these it dies at start-up.
# WebRender's GL path needs a GPU render node, which /dev/fb0 is not.
export MOZ_DISABLE_CONTENT_SANDBOX=1
export MOZ_DISABLE_GMP_SANDBOX=1
export MOZ_WEBRENDER=0

# The desktop's scale (Settings > Displays): myos-xsettings sets it up,
# then stays in the background to apply changes. It must come before the
# window manager, which reads the font DPI when it starts.
myos-xsettings

# Chinese input (IBus, Ctrl+Space), when it is installed. Before the desktop,
# so every program it starts inherits the variables. IBus keeps its settings
# with dconf, which needs $XDG_RUNTIME_DIR (myos-login makes it, in RAM).
if command -v ibus-daemon > /dev/null; then
    export GTK_IM_MODULE=ibus QT_IM_MODULE=ibus XMODIFIERS=@im=ibus
    ibus-daemon --daemonize --replace --xim
fi
[ -x "$HOME/.xsession" ] && exec "$HOME/.xsession"
exec icewm-session
