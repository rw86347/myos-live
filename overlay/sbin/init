# Process 1. The screen stays on the kernel's step list until login
# (agetty is started with --noclear). runit opens /dev/console itself,
# writes "booting" and "enter stage" there, and its stages inherit it,
# so first /dev/console goes to the serial port (myos-console: ioctl
# TIOCCONS): the screen keeps the steps, and only what is written to
# tty1 ("MyOS is up.", errors) joins them.
/usr/libexec/myos-console /dev/ttyS0 2>/dev/null
exec /sbin/runit-init "$@"
