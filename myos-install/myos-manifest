"""myos-manifest — the file list a live or installed root shipped with.

    myos-manifest write [ROOT]
    myos-manifest diff OLDROOT [STICKROOT]
    myos-manifest need OLDROOT [STICKROOT]

write walks ROOT (default /) and records every file in /usr/lib/myos/manifest:
path, kind, SHA-256, size, mode, owner, mtime, link target.

diff sorts each file of an installed root (OLDROOT, mounted) against its own
manifest and the stick's (STICKROOT's manifest, or a walk when it has none),
one "ACTION path" line each, then the totals the helper's space check needs:
  keep     changed here, in a place whose changes are kept (/etc, /usr/local...)
  sidecar  kept, and the stick's copy differs too: written as NAME.myos-new
  changed  changed here, elsewhere: saved to the backup, then replaced
  replace  the system's own: the stick's copy replaces it
  add      new on the stick
  gone     the system's, no longer on the stick: removed
  deleted  removed here from a kept place: stays removed
need prints only the totals.

A file whose size and mtime still match its manifest line is taken as
unchanged without reading it (rsync's quick check): the installer copies
with mtimes kept, so only files touched since are hashed.

Skipped: /proc /sys /dev /run /tmp /data /mnt /home /media /lost+found
/var/log /var/tmp. docs/INSTALLER-PLAN.md, "Upgrading from the stick".
"""
import hashlib
import os
import stat
import sys

MANIFEST = "usr/lib/myos/manifest"
SKIP = {"proc", "sys", "dev", "run", "tmp", "data", "mnt", "home", "media",
        "lost+found", "var/log", "var/tmp"}
KEEP_PREFIX = ("etc/", "usr/local/", "opt/", "root/", "srv/", "var/mail/",
               "var/spool/")
# Rebuilt by the helper from both sides, never kept or sidecar'd whole.
MERGE_FILES = {"etc/passwd", "etc/group", "etc/shadow", "etc/gshadow"}
# What the upgrade itself writes or the live session alone has.
IGNORE = {MANIFEST, MANIFEST + ".tmp"}


def die(msg):
    sys.exit("myos-manifest: " + msg)


def skipped(r):
    return any(r == s or r.startswith(s + "/") for s in SKIP)


def keep_path(r):
    return r not in MERGE_FILES and r.startswith(KEEP_PREFIX)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def entry(path, hash_it=True):
    """The manifest's facts about one path; None if it is gone or special."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    e = {"mode": st.st_mode & 0o7777, "uid": st.st_uid, "gid": st.st_gid,
         "size": 0, "mtime": int(st.st_mtime), "sha": "-", "target": ""}
    if stat.S_ISLNK(st.st_mode):
        e["kind"] = "l"
        try:
            e["target"] = os.readlink(path)
        except OSError:
            pass
    elif stat.S_ISREG(st.st_mode):
        e["kind"], e["size"] = "f", st.st_size
        if hash_it:
            try:
                e["sha"] = sha256_file(path)
            except OSError:
                return None
    elif stat.S_ISDIR(st.st_mode):
        e["kind"] = "d"
    else:
        return None
    return e


def walk(root, hash_it=True):
    """{relpath: entry} for everything under root but the skipped places."""
    root = os.path.abspath(root)
    out = {}
    for dirpath, dirnames, filenames in os.walk(root):
        rdir = os.path.relpath(dirpath, root)
        rdir = "" if rdir == "." else rdir
        keep_dirs = []
        for d in sorted(dirnames):
            r = d if not rdir else rdir + "/" + d
            if skipped(r):
                continue
            e = entry(os.path.join(dirpath, d), False)
            if e:
                out[r] = e
            if e and e["kind"] == "d":
                keep_dirs.append(d)     # a symlink to a folder: recorded, not entered
        dirnames[:] = keep_dirs
        for f in sorted(filenames):
            r = f if not rdir else rdir + "/" + f
            if skipped(r) or r in IGNORE:
                continue
            e = entry(os.path.join(dirpath, f), hash_it)
            if e:
                out[r] = e
    return out


def release_lines(root):
    path = os.path.join(root, "usr/lib/myos/release")
    try:
        with open(path) as f:
            return [l.rstrip("\n") for l in f if l.strip() and not l.startswith("#")]
    except OSError:
        return []


def write_cmd(root):
    root = os.path.abspath(root)
    dest = os.path.join(root, MANIFEST)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    rows = walk(root)
    tmp = dest + ".tmp"
    with open(tmp, "w") as f:
        f.write("# myos-manifest v1\n")
        for line in release_lines(root):
            f.write("# %s\n" % line)
        for r in sorted(rows):
            e = rows[r]
            f.write("%s\t%s\t%s\t%d\t%o\t%d\t%d\t%d\t%s\n" %
                    (r, e["kind"], e["sha"], e["size"], e["mode"], e["uid"], e["gid"],
                     e["mtime"], e["target"]))
    os.replace(tmp, dest)
    print("myos-manifest: wrote %s (%d entries)" % (dest, len(rows)))


def load_manifest(root):
    """{relpath: entry} from root's manifest; {} when it has none."""
    rec = {}
    try:
        f = open(os.path.join(root, MANIFEST))
    except OSError:
        return rec
    with f:
        for line in f:
            if line.startswith("#") or not line.strip():
                continue
            p = line.rstrip("\n").split("\t")
            if len(p) < 9:
                continue
            rec[p[0]] = {"kind": p[1], "sha": p[2], "size": int(p[3]),
                         "mode": int(p[4], 8), "uid": int(p[5]), "gid": int(p[6]),
                         "mtime": int(p[7]), "target": p[8]}
    return rec


def same(a, b):
    if not a or not b or a["kind"] != b["kind"]:
        return False
    if a["kind"] == "l":
        return a["target"] == b["target"]
    if a["kind"] == "f":
        return a["sha"] == b["sha"]
    return True


def unchanged(root, r, rec):
    """Does root's file still match its manifest line? Reads it only when
    size and mtime can't say."""
    now = entry(os.path.join(root, r), False)
    if now is None or now["kind"] != rec["kind"]:
        return False, now
    if now["kind"] == "l":
        return now["target"] == rec["target"], now
    if now["kind"] != "f":
        return True, now
    if now["size"] != rec["size"]:
        return False, now
    if now["mtime"] == rec["mtime"]:
        return True, now
    try:
        now["sha"] = sha256_file(os.path.join(root, r))
    except OSError:
        return False, now
    return now["sha"] == rec["sha"], now


def classify(oldroot, stickroot):
    """[(action, relpath, size on the stick, size on the disk)]."""
    old_m = load_manifest(oldroot)
    stick = load_manifest(stickroot) or walk(stickroot)
    out = []
    disk = walk(oldroot, hash_it=False)
    for r, now in sorted(disk.items()):
        if now["kind"] == "d" or r in IGNORE:
            continue
        rec = old_m.get(r)
        new = stick.get(r)
        on_stick = new is not None and new["kind"] != "d"
        if rec is not None and rec["kind"] != "d":
            ok, now = unchanged(oldroot, r, rec)
            changed = not ok
        else:
            # Not in the old manifest: made on this machine (or no manifest).
            changed = True
        if changed and keep_path(r):
            # The stick's copy also moved on since this disk's: put it beside.
            if on_stick and rec is not None and not same(rec, new):
                out.append(("sidecar", r, new["size"], now["size"]))
            else:
                out.append(("keep", r, 0, now["size"]))
        elif changed and on_stick and rec is not None:
            out.append(("changed", r, new["size"], now["size"]))
        elif on_stick:
            out.append(("replace", r, new["size"], now["size"]))
        elif changed and old_m:
            # Added here outside the kept places: saved, then removed.
            out.append(("changed", r, 0, now["size"]))
        else:
            out.append(("gone", r, 0, now["size"]))
    for r, new in sorted(stick.items()):
        if new["kind"] == "d" or r in disk or r in IGNORE or skipped(r):
            continue
        if r in old_m and keep_path(r):
            # This machine removed it (the installer removes the stick's
            # ssh keys, for one): it stays removed.
            out.append(("deleted", r, 0, 0))
        else:
            out.append(("add", r, new["size"], 0))
    return out


def totals(rows, oldroot):
    need = inodes = backup = 0
    for action, r, new_sz, old_sz in rows:
        if action == "add":
            need += new_sz
            inodes += 1
        elif action in ("replace", "changed") and new_sz > old_sz:
            need += new_sz - old_sz
        elif action == "sidecar":
            need += new_sz
            inodes += 1
        if action == "changed":
            backup += old_sz
    for dirpath, _, filenames in os.walk(os.path.join(oldroot, "etc")):
        for name in filenames:
            try:
                backup += os.lstat(os.path.join(dirpath, name)).st_size
            except OSError:
                pass
    return need, inodes, backup


def diff_cmd(oldroot, stickroot, quiet=False):
    rows = classify(oldroot, stickroot)
    counts = {}
    for action, r, _, _ in rows:
        counts[action] = counts.get(action, 0) + 1
        if not quiet:
            print("%s %s" % (action, r))
    need, inodes, backup = totals(rows, oldroot)
    print("# counts " + " ".join("%s=%d" % (k, counts.get(k, 0)) for k in
                                 ("keep", "sidecar", "changed", "replace", "add", "gone",
                                  "deleted")))
    print("BYTES=%d" % need)
    print("INODES=%d" % inodes)
    print("BACKUP=%d" % backup)


def main():
    if len(sys.argv) < 2:
        die("usage: myos-manifest write [ROOT] | diff OLDROOT [STICK] | need OLDROOT [STICK]")
    cmd = sys.argv[1]
    if cmd == "write":
        write_cmd(sys.argv[2] if len(sys.argv) > 2 else "/")
    elif cmd in ("diff", "need"):
        if len(sys.argv) < 3:
            die("%s needs OLDROOT" % cmd)
        diff_cmd(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else "/", quiet=cmd == "need")
    else:
        die("unknown command %s" % cmd)


if __name__ == "__main__":
    main()
